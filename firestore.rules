rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name','score','correct','total','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 16
        && request.resource.data.total is int
        && request.resource.data.total >= 1 && request.resource.data.total <= 50
        && request.resource.data.correct is int
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= request.resource.data.total
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= request.resource.data.correct * 150
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
